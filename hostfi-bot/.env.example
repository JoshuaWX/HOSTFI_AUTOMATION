# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=random_secret_string
WEBHOOK_URL=https://your-railway-domain.up.railway.app

# Admin Config
ADMIN_IDS=123456789,987654321
SUPERADMIN_ID=123456789
ADMIN_CHANNEL_ID=-1001234567890
COMMUNITY_GROUP_ID=-1009876543210

# Groq AI
GROQ_API_KEY=your_groq_api_key

# Supabase
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Upstash Redis
UPSTASH_REDIS_URL=rediss://your-upstash-url
UPSTASH_REDIS_TOKEN=your_upstash_token

# App Config
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=production
RAG_CONFIDENCE_THRESHOLD=0.72
MAX_MESSAGES_PER_MINUTE=10
CHROMA_PERSIST_PATH=./chroma_db
