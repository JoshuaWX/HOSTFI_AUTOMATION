# Telegram (REQUIRED)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=random_secret_string
WEBHOOK_URL=https://your-railway-domain.up.railway.app

# Admin Config
ADMIN_IDS=                          # Optional — leave empty, bot auto-detects group admins
SUPERADMIN_ID=123456789,987654321   # REQUIRED — comma-separated superadmin Telegram user IDs
ADMIN_CHANNEL_ID=-1001234567890     # Set after creating admin channel (0 = skip admin alerts)
COMMUNITY_GROUP_ID=-1009876543210,-1001111222233  # Comma-separated community group IDs

# Gemini AI (REQUIRED)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# X API (Required for automatic raid / X post XP)
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com/2

# Supabase (REQUIRED)
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Upstash Redis (Optional — bot works without it)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# App Config
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=production
RAG_CONFIDENCE_THRESHOLD=0.72
MAX_MESSAGES_PER_MINUTE=10
CHROMA_PERSIST_PATH=./chroma_db
